@page "/Account/Login"
@model DystenSoftwateManagment.Pages.LoginModel
@{
    ViewData["Title"] = "Logowanie";
}

<head>
    <link rel="stylesheet" href="/app.css" />
    <link rel="stylesheet" href="/css/Login_page.css" />
    <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@100;200;300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Source+Code+Pro:wght@200;300;400;500;600;700;800;900&display=swap" rel="stylesheet">
</head>


<div class="container">

    <div class="header">
        <img src="/Assets/login_logo.png" alt="Dysten" width="60" height="60" />
        <div class="header-text">
            <p>Zaloguj się</p>
            <p>Zaloguj się przy użyciu <br /> otrzymanego loginu i hasła</p>
        </div>
    </div>

    <form method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ReturnUrl" />

        <div class="form-content">

            <input id="Email" name="Email" type="text" placeholder="Login" value="@Model.Email" required />
            <input id="Password" name="Password" type="password" placeholder="Hasło" required />

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <span class="error-text">@Model.ErrorMessage</span>
            }

            <button type="submit" class="button-primary">Zaloguj się</button>
        </div>
    </form>
</div>