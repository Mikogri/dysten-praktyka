    public async Task Create()
    {
        var result = await PlatformsManager.AddAsync();

        if (result.OperationStatus != OperationResult.Canceled)
        {
            listView?.LoadAsync();
            Snackbar.Add(result.Message, Utilities.ToSeverity(result.OperationStatus));
        }
    }

    public async Task Edit(Platform platform)
    {
        var result = await PlatformsManager.EditAsync(platform);

        if (result.OperationStatus != OperationResult.Canceled)
        {
            listView?.LoadAsync();
            Snackbar.Add(result.Message, Utilities.ToSeverity(result.OperationStatus));
        }
    }

    public async Task EditNote(Platform platform)
    {
        var result = await PlatformsManager.EditNoteAsync(platform);

        if (result.OperationStatus != OperationResult.Canceled)
        {
            Snackbar.Add(result.Message, Utilities.ToSeverity(result.OperationStatus));
        }
    }

    public async Task Delete(int id)
    {
        var result = await PlatformsManager.DeleteAsync(id);

        if (result.OperationStatus != OperationResult.Canceled)
        {
            listView?.LoadAsync();
            Snackbar.Add(result.Message, Utilities.ToSeverity(result.OperationStatus));
        }
    }

