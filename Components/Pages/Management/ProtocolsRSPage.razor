@page "/rs-protocols"
@attribute [Authorize]
@using DystenSoftwateManagment.Components.Controls.List
@using Microsoft.AspNetCore.Authorization
@using DystenSoftwateManagment.Data
@using DystenSoftwateManagment.Managers
@using DystenSoftwateManagment.Utility
@using DystenSoftwateManagment.Models
@using DystenSoftwateManagment.Components.Controls
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject ProtocolsRSManager ProtocolsRSManager
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject Blazored.LocalStorage.ILocalStorageService localStorage

<PageTitle>Protokoły RS</PageTitle>

<ListView @ref="listView" 
          TItem="ProtocolRS"
          Title="Protokoły RS"
          IconSrc="/Assets/rsprotocol.png"
          GetName="item => item.Name"
          LoadItemsFunc="ProtocolsRSManager.GetAllAsync">

    <TableColumns>
        <col />
        <col />
        <col />
        <col />
    </TableColumns>

    <TableHeaders>
        <MudTh>Nazwa</MudTh>
        <MudTh>Status protokołu</MudTh>
        <MudTh>Rozmiar pliku</MudTh>
        <MudTh>Nazwa pliku</MudTh>
    </TableHeaders>

    <RowTemplate Context="item">
        <MudTd>@item.Name</MudTd>
        <MudTd>
            <div class="status-container">
                @(item.IsActive ? "aktywny" : "nie aktywny")
                <div class="status-dot @item.IsActive" />
            </div>
        </MudTd>

        <MudTd>@Utilities.ByteToMb(item.FileLength)</MudTd>

        <MudTd>@(item.FileName ?? "---")</MudTd>
    </RowTemplate>

    <ItemActionsMenu Context="item">
        <button class="context-menu-item" @onclick="() => Edit(item)">
            <img src="/Assets/edit.png" />
            Edytuj protokół
        </button>
        <a class="context-menu-item context-menu-item-a" href="/download/rs-protocol/@item.Id" download="@item.FileName">
            <img src="/Assets/downloadcloud.png" width="15" height="15" />
            Pobierz plik
        </a>
        <button class="context-menu-item" @onclick="() => Delete(item.Id)">
            <img src="/Assets/delete.png" />
            Usuń protokół
        </button>
    </ItemActionsMenu>

    <ActionsContent>
        <button class="button-add" @onclick="Create">
            <img src="/Assets/plus.png" width="15" height="15" />
            Nowy protokół
        </button>
    </ActionsContent>

    <CardInnerContent Context="item">
        <div class="status-container">
            @($"Status: {(item.IsActive ? "aktywny" : "nie aktywny")}")
            <div class="status-dot @item.IsActive" />
        </div>
        <p>@Utilities.ByteToMb(item.FileLength)</p>
    </CardInnerContent>

</ListView>


@code {

    private ListView<ProtocolRS>? listView;

    public async Task Create()
    {
        var result = await ProtocolsRSManager.AddAsync();

        if (result.OperationStatus != OperationResult.Canceled)
        {
            listView?.LoadAsync();
            Snackbar.Add(result.Message, Utilities.ToSeverity(result.OperationStatus));
        }
    }

    public async Task Edit(ProtocolRS protocol)
    {
        var result = await ProtocolsRSManager.EditAsync(protocol);

        if (result.OperationStatus != OperationResult.Canceled)
        {
            listView?.LoadAsync();
            Snackbar.Add(result.Message, Utilities.ToSeverity(result.OperationStatus));
        }
    }

    public async Task Delete(int id)
    {
        var result = await ProtocolsRSManager.DeleteAsync(id);

        if (result.OperationStatus != OperationResult.Canceled)
        {
            listView?.LoadAsync();
            Snackbar.Add(result.Message, Utilities.ToSeverity(result.OperationStatus));
        }
    }
}
