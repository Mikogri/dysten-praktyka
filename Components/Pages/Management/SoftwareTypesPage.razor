    public async Task Create()
    {
        var result = await SoftwareTypesManager.AddAsync();

        if (result.OperationStatus != OperationResult.Canceled)
        {
            listView?.LoadAsync();
            Snackbar.Add(result.Message, Utilities.ToSeverity(result.OperationStatus));
        }
    }

    public async Task Edit(SoftwareType softwareType)
    {
        var result = await SoftwareTypesManager.EditAsync(softwareType);

        if (result.OperationStatus != OperationResult.Canceled)
        {
            listView?.LoadAsync();
            Snackbar.Add(result.Message, Utilities.ToSeverity(result.OperationStatus));
        }
    }

    public async Task EditNote(SoftwareType softwareType)
    {
        var result = await SoftwareTypesManager.EditNoteAsync(softwareType);

        if (result.OperationStatus != OperationResult.Canceled)
        {
            Snackbar.Add(result.Message, Utilities.ToSeverity(result.OperationStatus));
        }
    }

    public async Task Delete(int id)
    {
        var result = await SoftwareTypesManager.DeleteAsync(id);

        if (result.OperationStatus != OperationResult.Canceled)
        {
            listView?.LoadAsync();
            Snackbar.Add(result.Message, Utilities.ToSeverity(result.OperationStatus));
        }
    }

