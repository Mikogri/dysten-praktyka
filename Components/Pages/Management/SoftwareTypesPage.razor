@page "/managesoftwaretypes"
@attribute [Authorize]
@using DystenSoftwateManagment.Components.Controls.List
@using DystenSoftwateManagment.Data
@using DystenSoftwateManagment.Models
@using DystenSoftwateManagment.Managers
@using DystenSoftwateManagment.Utility
@using DystenSoftwateManagment.Components.Controls
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@using Microsoft.AspNetCore.Authorization
@rendermode InteractiveServer
@inject SoftwareTypesManager SoftwareTypesManager
@inject ISnackbar Snackbar

<PageTitle>Typy oprogramowania</PageTitle>

<ListView @ref="listView" 
          TItem="SoftwareType"
          Title="Lista Platform"
          IconSrc="/Assets/platform.png"
          GetName="item => item.Name"
          LoadItemsFunc="SoftwareTypesManager.GetAllAsync">

    <TableColumns>
        <col />
        <col />
    </TableColumns>

    <TableHeaders>
        <MudTh>Nazwa</MudTh>
        <MudTh>Oprogramowania</MudTh>
    </TableHeaders>

    <RowTemplate Context="item">
        <MudTd>@item.Name</MudTd>
        <MudTd>@item.DeviceSoftwares.Count</MudTd>
    </RowTemplate>

    <ItemActionsMenu Context="item">
        <button class="context-menu-item" @onclick="() => Edit(item)">
            <img src="/Assets/edit.png" />
            Edytuj typ
        </button>
        <button class="context-menu-item" @onclick="() => EditNote(item)">
            <img src="/Assets/note.png" />
            Otwórz notatkę
        </button>
        <button class="context-menu-item" @onclick="() => Delete(item.Id)">
            <img src="/Assets/delete.png" />
            Usuń typ
        </button>
    </ItemActionsMenu>

    <ActionsContent>
        <button class="button-add" @onclick="Create">
            <img src="/Assets/plus.png" width="15" height="15" />
            Nowy typ
        </button>
    </ActionsContent>

    <CardInnerContent Context="item">
        Oprogramowania: @item.DeviceSoftwares.Count
    </CardInnerContent>

</ListView>

@code {

    private ListView<SoftwareType>? listView;

    public async Task Create()
    {
        var result = await SoftwareTypesManager.AddAsync();

        if (result.OperationStatus != OperationResult.Canceled)
        {
            listView?.LoadAsync();
            Snackbar.Add(result.Message, Utilities.ToSeverity(result.OperationStatus));
        }
    }

    public async Task Edit(SoftwareType softwareType)
    {
        var result = await SoftwareTypesManager.EditAsync(softwareType);

        if (result.OperationStatus != OperationResult.Canceled)
        {
            listView?.LoadAsync();
            Snackbar.Add(result.Message, Utilities.ToSeverity(result.OperationStatus));
        }
    }

    public async Task EditNote(SoftwareType softwareType)
    {
        var result = await SoftwareTypesManager.EditNoteAsync(softwareType);

        if (result.OperationStatus != OperationResult.Canceled)
        {
            Snackbar.Add(result.Message, Utilities.ToSeverity(result.OperationStatus));
        }
    }

    public async Task Delete(int id)
    {
        var result = await SoftwareTypesManager.DeleteAsync(id);

        if (result.OperationStatus != OperationResult.Canceled)
        {
            listView?.LoadAsync();
            Snackbar.Add(result.Message, Utilities.ToSeverity(result.OperationStatus));
        }
    }
}
