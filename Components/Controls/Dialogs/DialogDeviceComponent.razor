@using DystenSoftwateManagment.Models
@using MudBlazor

<MudDialog Class="dialog-background"
           ActionsClass="dialog-actions"
           ContentClass="dialog-content"
           TitleClass="dialog-header">

    <TitleContent>
        @MudDialog.Title

        <button class="button-icon button-opacity">
            <img src="/Assets/close.png" @onclick="Cancel" />
        </button>
    </TitleContent>

    <DialogContent>
        <MudStack Spacing="5">
            <InputField @bind-Value="@Component.Name" Placeholder="Nazwa" Label="Nazwa" />

            <InputField @bind-Value="@Component.Model" Placeholder="Model" Label="Model" />

            <InputField @bind-Value="@Component.Manufacturer" Placeholder="Producent" Label="Producent" />

            <CheckBox @bind-Value="Component.IsActive"
                      Label="Aktywny" />

            @if (!string.IsNullOrWhiteSpace(errorText))
            {
                <span class="error-text">@errorText</span>
            }

        </MudStack>
    </DialogContent>

    <DialogActions>
        <button class="button-primary" @onclick="Submit" disabled="@isLoading">
            @if (isLoading)
            {
                <div class="progress-bar">
                    <MudProgressCircular Indeterminate="true"
                                         Size="Size.Small"
                                         Color="Color.Secondary" />
                </div>
            }
            else
            {
                <span>@ButtonText</span>
            }
        </button>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }

    [Parameter]
    public DeviceComponent Component { get; set; }

    [Parameter]
    public string ButtonText { get; set; } = "Dodaj";

    [Parameter]
    public Func<DeviceComponent, Task<string>> ValidationResult { get; set; }

    private string errorText = string.Empty;

    private bool isLoading = false;

    private async Task Submit()
    {
        errorText = string.Empty;
        isLoading = true;
        await Task.Delay(10);

        try
        {
            string result = string.Empty;

            if (ValidationResult != null)
            {
                result = await ValidationResult(Component);
            }

            if (string.IsNullOrEmpty(result))
            {
                MudDialog.Close(DialogResult.Ok(Component));
            }
            else
            {
                errorText = result;
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}