<MudDialog Class="dialog-background" 
           ActionsClass="dialog-actions" 
           ContentClass="dialog-content" 
           TitleClass="dialog-header">

    <TitleContent>
        @MudDialog.Title

        <button class="button-icon button-opacity">
            <img src="/Assets/close.png" @onclick="Cancel" />
        </button>
    </TitleContent>
    <DialogContent>
        <textarea class="description-input" @bind="ContentText" placeholder="Opis" rows="10"/>
    </DialogContent>
    <DialogActions>
        <button class="button-primary" @onclick="Submit" disabled="@isLoading">
            @if (isLoading)
            {
                <div class="progress-bar">
                    <MudProgressCircular Indeterminate="true"
                                         Size="Size.Small"
                                         Color="Color.Secondary" />
                </div>
            }
            else
            {
                <span>Zapisz</span>
            }
        </button>
    </DialogActions>
</MudDialog>

@code {

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }

    [Parameter]
    public string ContentText { get; set; } = string.Empty;

    private bool isLoading = false;

    private async Task Submit()
    {
        isLoading = true;
        await Task.Delay(10);

        try
        {
            MudDialog.Close(DialogResult.Ok(ContentText));
        }
        finally
        {
            isLoading = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
